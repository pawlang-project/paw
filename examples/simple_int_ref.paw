// 基本类型引用测试（完整版）

fn swap(a: &mut i32, b: &mut i32) {
    let temp: i32 = *a;
    *a = *b;
    *b = temp;
}

fn increment(x: &mut i32) {
    *x = *x + 1;
}

fn read_only(x: &i32) -> i32 {
    return *x;
}

fn main() -> i32 {
    println("=== 基本类型引用测试 ===");
    
    // 测试1: swap
    let mut x: i32 = 10;
    let mut y: i32 = 20;
    swap(&mut x, &mut y);
    assert(x == 20);
    assert(y == 10);
    println("✓ swap测试通过");
    
    // 测试2: increment
    let mut n: i32 = 100;
    increment(&mut n);
    assert(n == 101);
    println("✓ increment测试通过");
    
    // 测试3: 只读引用
    let val: i32 = 42;
    let result: i32 = read_only(&val);
    assert(result == 42);
    println("✓ 只读引用测试通过");
    
    println("\n✅ 所有测试通过！");
    return 0;
}
