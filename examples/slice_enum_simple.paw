// 简单的枚举切片测试

type Color = enum {
    Red,
    Green,
    Blue,
}

// 计算红色的数量
fn count_red(colors: [Color]) -> i32 {
    let mut count: i32 = 0;
    loop c in colors {
        if c is Red {
            count = count + 1;
        }
    }
    return count;
}

fn main() -> i32 {
    let c1: Color = Color::Red;
    let c2: Color = Color::Green;
    let c3: Color = Color::Red;
    
    let colors: [Color] = [c1, c2, c3];
    
    return count_red(colors);  // 应该返回 2
}

