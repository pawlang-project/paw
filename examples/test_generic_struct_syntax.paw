// 测试泛型struct的实例化语法

type Box<T> = struct {
    value: T,
}

fn main() -> i32 {
    println("测试泛型struct实例化语法");
    
    // 方式1：隐式推导
    let b1 = Box { value: 42 };
    println("方式1: let b1 = Box { value: 42 }");
    
    // 方式2：显式类型标注
    let b2: Box = Box { value: 42 };
    println("方式2: let b2: Box = Box { value: 42 }");
    
    // 方式3：是否支持 Box<i32> { value: 42 }？
    // let b3 = Box<i32> { value: 42 };
    
    return 0;
}

