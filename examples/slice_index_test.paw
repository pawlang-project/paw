// 测试切片索引

fn get_element(arr: [i32], index: i32) -> i32 {
    return arr[index];
}

fn main() -> i32 {
    let arr: [i32] = [10, 20, 30, 40, 50];
    
    let a: i32 = get_element(arr, 0);  // 10
    let b: i32 = get_element(arr, 2);  // 30
    let c: i32 = get_element(arr, 4);  // 50
    
    return a + b + c;  // 90
}

