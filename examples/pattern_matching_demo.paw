// PawLang 模式匹配演示 - 简化版（使用已支持的语法）

fn test_basic() {
    let x = 42;
    let result = x is {
        42 => 100,
        _ => 0,
    };
    println(result);
}

fn test_result() {
    let r: i32! = ok(42);
    
    let value = r is {
        ok(v) => v,
        err(e) => 0,
    };
    
    println(value);
}

fn main() {
    println("=== 模式匹配演示 ===");
    test_basic();
    test_result();
    println("=== 演示完成 ===");
}
