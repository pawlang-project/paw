// Vec<T> 高阶函数测试（闭包专属）🔥

type VecI32 = struct {
    data: [i32; 128],
    len: i64,
    
    fn new() -> VecI32 {
        let arr: [i32; 128];
        return VecI32 { data: arr, len: 0 };
    }
    
    fn push(mut self, value: i32) -> VecI32 {
        if self.len >= 128 {
            panic("Vec is full");
        }
        self.data[self.len] = value;
        self.len = self.len + 1;
        return self;
    }
    
    fn get(self, index: i64) -> i32 {
        return self.data[index];
    }
    
    fn len(self) -> i64 {
        return self.len;
    }
    
    // ========== 高阶函数（闭包）🔥 ==========
    
    // map: 转换每个元素
    fn map(self, f: fn(i32) -> i32) -> VecI32 {
        let mut result: VecI32 = VecI32::new();
        
        let mut i: i64 = 0;
        loop i < self.len {
            let transformed: i32 = f(self.data[i]);
            result = result.push(transformed);
            i = i + 1;
        }
        
        return result;
    }
    
    // filter: 筛选元素
    fn filter(self, predicate: fn(i32) -> bool) -> VecI32 {
        let mut result: VecI32 = VecI32::new();
        
        let mut i: i64 = 0;
        loop i < self.len {
            if predicate(self.data[i]) {
                result = result.push(self.data[i]);
            }
            i = i + 1;
        }
        
        return result;
    }
    
    // for_each: 遍历
    fn for_each(self, f: fn(i32)) {
        let mut i: i64 = 0;
        loop i < self.len {
            f(self.data[i]);
            i = i + 1;
        }
    }
    
    // fold: 归约
    fn fold(self, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        let mut acc: i32 = init;
        
        let mut i: i64 = 0;
        loop i < self.len {
            acc = f(acc, self.data[i]);
            i = i + 1;
        }
        
        return acc;
    }
}

fn main() -> i32 {
    println("=== Vec<T> Closure Test ===");
    
    // 创建Vec
    let mut v: VecI32 = VecI32::new();
    v = v.push(1);
    v = v.push(2);
    v = v.push(3);
    v = v.push(4);
    v = v.push(5);
    
    println("1. Original: [1, 2, 3, 4, 5]");
    
    // map: 每个元素 * 2
    let doubled: VecI32 = v.map((x: i32) -> i32 { return x * 2; });
    let i0: i64 = 0;
    let i1: i64 = 1;
    let i2: i64 = 2;
    let i3: i64 = 3;
    let i4: i64 = 4;
    println(f"2. Doubled: [{doubled.get(i0)}, {doubled.get(i1)}, {doubled.get(i2)}, {doubled.get(i3)}, {doubled.get(i4)}]");
    
    // filter: 只保留偶数
    let evens: VecI32 = v.filter((x: i32) -> bool { return x % 2 == 0; });
    println(f"3. Evens: [{evens.get(i0)}, {evens.get(i1)}]");
    
    // fold: 求和
    let sum: i32 = v.fold(0, (acc: i32, x: i32) -> i32 { return acc + x; });
    println(f"4. Sum: {sum}");
    
    println("=== All closure tests passed! ===");
    return 0;
}

