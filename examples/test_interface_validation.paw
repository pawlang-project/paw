// 接口系统 - 签名验证测试

type Display = interface {
    fn show();
    fn debug();
};

type Point = struct {
    x: i32,
    y: i32
};

support Point with Display {
    fn show() {
        println("Showing Point");
    }
    
    fn debug() {
        println("Debugging Point");
    }
}

fn main() {
    println("Interface validation test completed!");
}

