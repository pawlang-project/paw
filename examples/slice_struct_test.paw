// 测试结构体切片

type Point = struct {
    x: i32,
    y: i32,
}

// 接收Point切片
fn sum_x_coords(points: [Point]) -> i32 {
    let mut total: i32 = 0;
    loop p in points {
        total = total + p.x;
    }
    return total;
}

// 计算所有点的总和
fn sum_all_coords(points: [Point]) -> i32 {
    let mut total: i32 = 0;
    loop p in points {
        total = total + p.x + p.y;
    }
    return total;
}

// 通过索引访问
fn get_point_x(points: [Point], index: i32) -> i32 {
    return points[index].x;
}

fn main() -> i32 {
    let p1: Point = Point { x: 10, y: 20 };
    let p2: Point = Point { x: 30, y: 40 };
    let p3: Point = Point { x: 50, y: 60 };
    
    let points: [Point] = [p1, p2, p3];
    
    let sum_x: i32 = sum_x_coords(points);      // 10 + 30 + 50 = 90
    let sum_all: i32 = sum_all_coords(points);  // 90 + 120 = 210
    let first_x: i32 = get_point_x(points, 0);  // 10
    
    return sum_x + sum_all + first_x;  // 90 + 210 + 10 = 310
}

