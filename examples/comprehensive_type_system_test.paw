// PawLang 完整类型系统测试
// 测试所有28种类型，覆盖边界情况和极端场景

// ============================================
// 1. 基础类型测试 - 所有整数类型
// ============================================

fn test_integer_types() {
    // 有符号整数 - 边界值测试
    let i8_min: i8 = -128;
    let i8_max: i8 = 127;
    let i8_zero: i8 = 0;
    
    let i16_min: i16 = -32768;
    let i16_max: i16 = 32767;
    
    let i32_min: i32 = -2147483648;
    let i32_max: i32 = 2147483647;
    
    let i64_large: i64 = 9223372036854775807;
    let i64_negative: i64 = -9223372036854775808;
    
    // 无符号整数 - 边界值测试
    let u8_min: u8 = 0;
    let u8_max: u8 = 255;
    
    let u16_min: u16 = 0;
    let u16_max: u16 = 65535;
    
    let u32_min: u32 = 0;
    let u32_max: u32 = 4294967295;
    
    let u64_large: u64 = 18446744073709551615;
    
    println("整数类型测试通过");
}

// ============================================
// 2. 浮点类型测试
// ============================================

fn test_float_types() {
    // 浮点数边界和特殊值
    let f32_zero: f32 = 0.0;
    let f32_pos: f32 = 3.14159;
    let f32_neg: f32 = -2.71828;
    let f32_large: f32 = 1000000.0;
    let f32_small: f32 = 0.00001;
    
    let f64_precise: f64 = 3.141592653589793;
    let f64_scientific: f64 = 1.23e10;
    let f64_tiny: f64 = 1.23e-10;
    
    println("浮点类型测试通过");
}

// ============================================
// 3. 其他基础类型测试
// ============================================

fn test_other_primitive_types() {
    // 布尔类型
    let b_true: bool = true;
    let b_false: bool = false;
    let b_expr: bool = 10 > 5;
    
    // 字符类型
    let ch_ascii: char = 'A';
    let ch_digit: char = '9';
    let ch_special: char = '@';
    
    // 字符串类型
    let s_empty: string = "";
    let s_short: string = "Hello";
    let s_long: string = "这是一个很长的字符串，用来测试字符串类型的处理能力";
    let s_special: string = "带有\n特殊\t字符的字符串";
    
    println("基础类型测试通过");
}

// ============================================
// 4. 数组类型测试 - 各种场景
// ============================================

fn test_array_types() {
    // 不同元素类型的数组
    let arr_i32: [i32; 5] = [1, 2, 3, 4, 5];
    let arr_bool: [bool; 3] = [true, false, true];
    let arr_large: [i32; 100];  // 大数组
    
    // 数组访问测试 - 边界情况
    let first = arr_i32[0];
    let last = arr_i32[4];
    let middle = arr_i32[2];
    
    // 嵌套数组（如果支持）
    // let matrix: [[i32; 3]; 3];
    
    println("数组类型测试通过");
}

// ============================================
// 5. 元组类型测试 - 复杂组合
// ============================================

fn test_tuple_types() {
    // 简单元组
    let pair: (i32, i32) = (10, 20);
    let triple: (i32, bool, string) = (42, true, "test");
    
    // 嵌套元组
    let nested: ((i32, i32), (bool, bool)) = ((1, 2), (true, false));
    
    // 不同类型的复杂元组
    let complex: (i32, f64, bool, string, char) = (1, 3.14, true, "hello", 'A');
    
    // 元组解构
    let (x, y) = pair;
    let (a, b, c) = triple;
    
    // 元组字段访问
    let first = pair.0;
    let second = pair.1;
    
    println("元组类型测试通过");
}

// ============================================
// 6. 结构体类型测试
// ============================================

type Point = struct {
    x: i32,
    y: i32
}

type Person = struct {
    name: string,
    age: i32,
    height: f64,
    is_active: bool
}

type ComplexStruct = struct {
    id: i32,
    data: (i32, string),
    nested_point: Point
}

fn test_struct_types() {
    // 基本结构体
    let p1 = Point { x: 10, y: 20 };
    let p2 = Point { x: -100, y: 0 };
    
    // 复杂结构体
    let person = Person {
        name: "Alice",
        age: 30,
        height: 165.5,
        is_active: true
    };
    
    // 嵌套结构体
    let complex = ComplexStruct {
        id: 1,
        data: (42, "test"),
        nested_point: Point { x: 5, y: 5 }
    };
    
    // 字段访问
    let x_val = p1.x;
    let person_age = person.age;
    let nested_x = complex.nested_point.x;
    
    println("结构体类型测试通过");
}

// ============================================
// 7. 枚举类型测试 - 各种变体
// ============================================

type SimpleEnum = enum {
    Variant1,
    Variant2,
    Variant3
}

type DataEnum = enum {
    None,
    Int(i32),
    String(string),
    Pair(i32, i32)
}

type Option<T> = enum {
    Some(T),
    None
}

type Result<T, E> = enum {
    Ok(T),
    Err(E)
}

fn test_enum_types() {
    // 简单枚举
    let status = SimpleEnum::Variant1;
    
    // 带数据的枚举
    let int_data = DataEnum::Int(42);
    let str_data = DataEnum::String("test");
    let pair_data = DataEnum::Pair(10, 20);
    let none_data = DataEnum::None;
    
    // 泛型枚举
    let some_int = Option::Some(42);
    let some_str = Option::Some("hello");
    let none_val = Option::None;
    
    let ok_result = Result::Ok(100);
    let err_result = Result::Err("error");
    
    // 嵌套泛型枚举
    let nested = Option::Some(Option::Some(42));
    
    println("枚举类型测试通过");
}

// ============================================
// 8. 引用类型测试
// ============================================

fn test_reference_types() {
    let x: i32 = 42;
    let ref_x: &i32 = &x;
    let val = *ref_x;
    
    let~ y: i32 = 100;
    let mut_ref: &~i32 = &~y;
    // *mut_ref = 200;
    
    println("引用类型测试通过");
}

// ============================================
// 9. 函数类型测试
// ============================================

fn test_function_types() {
    // 函数类型变量
    let add_fn: fn(i32, i32) -> i32 = (x: i32, y: i32) -> i32 {
        return x + y;
    };
    
    let result = add_fn(10, 20);
    
    // 无参数函数
    let greet: fn() = () {
        println("Hello!");
    };
    
    println("函数类型测试通过");
}

// ============================================
// 10. Optional类型测试 (T?)
// ============================================

fn test_optional_types() {
    // 基本Optional类型
    let some_val: i32? = 42;
    let none_val: i32? = null;
    
    // 不同类型的Optional
    let opt_string: string? = "hello";
    let opt_bool: bool? = true;
    let opt_float: f64? = 3.14;
    
    // null检查
    if none_val == null {
        println("是null");
    }
    
    // 模式匹配
    let result = some_val is {
        null => 0,
        value => value,
    };
    
    println("Optional类型测试通过");
}

// ============================================
// 11. Result类型测试 (T!)
// ============================================

fn divide(a: i32, b: i32) -> i32! {
    if b == 0 {
        return err("除零错误");
    }
    return ok(a / b);
}

fn test_result_types() {
    // 成功情况
    let ok_result = divide(10, 2);
    
    // 失败情况
    let err_result = divide(10, 0);
    
    // 模式匹配
    let value1 = ok_result is {
        ok(v) => v,
        err(msg) => {
            println(msg);
            0
        },
    };
    
    let value2 = err_result is {
        ok(v) => v,
        err(msg) => {
            println(msg);
            -1
        },
    };
    
    println("Result类型测试通过");
}

// ============================================
// 12. 泛型类型测试 - 复杂场景
// ============================================

type Box<T> = struct {
    value: T
}

type Pair<T, U> = struct {
    first: T,
    second: U
}

type Triple<A, B, C> = struct {
    a: A,
    b: B,
    c: C
}

fn test_generic_types() {
    // 单泛型参数
    let box_int = Box { value: 42 };
    let box_str = Box { value: "hello" };
    let box_bool = Box { value: true };
    
    // 多泛型参数
    let pair1 = Pair { first: 1, second: "one" };
    let pair2 = Pair { first: true, second: 3.14 };
    
    // 三泛型参数
    let triple = Triple { a: 1, b: "two", c: true };
    
    // 嵌套泛型
    let nested_box = Box { value: Box { value: 42 } };
    let box_pair = Box { value: Pair { first: 1, second: 2 } };
    
    println("泛型类型测试通过");
}

// ============================================
// 13. 类型转换测试 - 所有合法转换
// ============================================

fn test_type_conversions() {
    // 整数之间转换
    let i8_val: i8 = 127;
    let i16_val: i16 = i8_val as i16;
    let i32_val: i32 = i16_val as i32;
    let i64_val: i64 = i32_val as i64;
    
    // 有符号到无符号
    let signed: i32 = 100;
    let unsigned: u32 = signed as u32;
    
    // 无符号到有符号
    let u_val: u32 = 100;
    let i_val: i32 = u_val as i32;
    
    // 整数到浮点数
    let int_num: i32 = 42;
    let float_num: f64 = int_num as f64;
    
    // 浮点数到整数（截断）
    let f_val: f64 = 3.99;
    let i_truncated: i32 = f_val as i32;  // 应该是3
    
    // 浮点数之间转换
    let f32_val: f32 = 3.14;
    let f64_val: f64 = f32_val as f64;
    
    // 缩小转换（可能溢出）
    let large: i32 = 1000;
    let small: i8 = large as i8;  // 溢出
    
    println("类型转换测试通过");
}

// ============================================
// 14. 极端边界情况测试
// ============================================

fn test_edge_cases() {
    // 空数组（如果支持）
    // let empty_arr: [i32; 0];
    
    // 单元素数组
    let single: [i32; 1] = [42];
    
    // 空元组（unit类型）
    let unit: () = ();
    
    // 最大深度嵌套
    let deep_nested = ((((1, 2), 3), 4), 5);
    
    // 大数组
    let large_array: [i32; 1000];
    
    // 零值
    let zero_int: i32 = 0;
    let zero_float: f64 = 0.0;
    let empty_str: string = "";
    
    println("边界情况测试通过");
}

// ============================================
// 15. 类型推导测试
// ============================================

fn test_type_inference() {
    // 字面量推导
    let inferred_int = 42;          // i32
    let inferred_float = 3.14;      // f64
    let inferred_bool = true;       // bool
    let inferred_string = "hello";  // string
    
    // 数组推导
    let inferred_array = [1, 2, 3, 4, 5];  // [i32; 5]
    
    // 元组推导
    let inferred_tuple = (1, "two", true);  // (i32, string, bool)
    
    // 泛型推导
    let inferred_box = Box { value: 42 };  // Box<i32>
    let inferred_pair = Pair { first: 1, second: "one" };  // Pair<i32, string>
    
    println("类型推导测试通过");
}

// ============================================
// 16. 复合类型组合测试
// ============================================

type ComplexType = struct {
    array_field: [i32; 5],
    tuple_field: (i32, string, bool),
    optional_field: i32?,
    result_field: string!,
    box_field: Box<i32>
}

fn test_complex_combinations() {
    // Option<Result<T>>
    let opt_result: Result<i32, string>? = Option::Some(Result::Ok(42));
    
    // Array of Options
    // let opt_array: [i32?; 5];
    
    // Tuple with mixed types
    let mixed_tuple: (i32, i32?, string!, Box<bool>) = (
        42,
        null,
        ok("test"),
        Box { value: true }
    );
    
    println("复合类型组合测试通过");
}

// ============================================
// 主测试函数
// ============================================

fn main() {
    println("========================================");
    println("PawLang 完整类型系统测试");
    println("========================================");
    
    test_integer_types();
    test_float_types();
    test_other_primitive_types();
    test_array_types();
    test_tuple_types();
    test_struct_types();
    test_enum_types();
    test_reference_types();
    test_function_types();
    test_optional_types();
    test_result_types();
    test_generic_types();
    test_type_conversions();
    test_edge_cases();
    test_type_inference();
    test_complex_combinations();
    
    println("========================================");
    println("所有类型系统测试完成!");
    println("========================================");
}










