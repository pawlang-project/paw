// 接口系统 - self参数测试

type Display = interface {
    fn show(self);
};

type Point = struct {
    x: i32,
    y: i32
};

support Point with Display {
    fn show(self) {
        println(self.x);
        println(self.y);
    }
}

fn main() {
    let p = Point { x: 10, y: 20 };
    // p.show();  // 暂时无法调用，需要实现方法调用
    println("Interface self test completed!");
}

