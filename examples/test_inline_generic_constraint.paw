// 测试内联实现是否支持泛型约束

type Display = interface {
    fn to_string(self) -> string;
}

type Clone = interface {
    fn clone(self) -> Self;
}

// ✅ 测试1：struct 泛型参数带约束
type Box<T: Display> = struct {
    value: T,
}

// ✅ 测试2：struct 泛型参数带约束 + 内联实现
type Wrapper<T: Display> = struct(Clone) {
    value: T,
    
    fn clone(self) -> Wrapper<T> {
        return Wrapper { value: self.value };
    }
}

// ✅ 测试3：多个约束 + 内联实现
type Container<T: Display + Clone> = struct(Display) {
    value: T,
    
    fn to_string(self) -> string {
        return "Container";
    }
}

fn main() -> i32 {
    println("===== 内联实现泛型约束测试 =====");
    println("✅ type Box<T: Display> - 约束语法支持");
    println("✅ type Wrapper<T: Display> = struct(Clone) - 约束+内联");
    println("✅ type Container<T: Display + Clone> = struct(Display)");
    return 0;
}

