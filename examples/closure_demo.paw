// PawLang 闭包演示 - 简化版

fn test_basic_closure() {
    let add = (x: i32, y: i32) -> i32 { x + y };
    println(add(5, 3));
}

fn test_capture() {
    let base = 10;
    let add_base = (x: i32) -> i32 { x + base };
    println(add_base(5));
}

fn main() {
    println("=== 闭包功能演示 ===");
    test_basic_closure();
    test_capture();
    println("=== 演示完成 ===");
}
