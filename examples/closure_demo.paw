// PawLang 闭包功能完整演示
// 展示闭包的各种用法和特性

// ============================================
// 1. 基础闭包
// ============================================

fn test_basic_closure() {
    // ✅ 简单闭包
    let add = (x: i32, y: i32) -> i32 {
        return x + y;
    };
    
    let result = add(10, 20);
    println(result);  // 30
}

// ============================================
// 2. ✨ 隐式返回（新增）
// ============================================

fn test_implicit_return() {
    // ✅ 单表达式隐式返回
    let double = (x: i32) -> i32 { x * 2 };
    
    // ✅ 块表达式隐式返回
    let complex = (x: i32) -> i32 {
        let y = x * 2;
        let z = y + 10;
        z  // 无分号 = 隐式返回
    };
    
    println(double(5));   // 10
    println(complex(5));  // 20
}

// ============================================
// 3. ✨ 环境捕获（新增）
// ============================================

fn test_capture() {
    let base = 100;
    
    // ✅ 捕获外部变量
    let add_base = (x: i32) -> i32 {
        x + base  // 捕获base
    };
    
    println(add_base(50));  // 150
}

// ============================================
// 4. 闭包工厂
// ============================================

fn make_adder(base: i32) -> fn(i32) -> i32 {
    // ✅ 返回捕获base的闭包
    return (x: i32) -> i32 {
        x + base
    };
}

fn test_closure_factory() {
    let add10 = make_adder(10);
    let add100 = make_adder(100);
    
    println(add10(5));   // 15
    println(add100(5));  // 105
}

// ============================================
// 5. 高阶函数与闭包
// ============================================

fn apply(x: i32, f: fn(i32) -> i32) -> i32 {
    return f(x);
}

fn twice(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(f(x));
}

fn test_higher_order() {
    // 传递闭包给高阶函数
    let result1 = apply(10, (x: i32) -> i32 { x * 2 });
    
    let square = (x: i32) -> i32 { x * x };
    let result2 = twice(square, 3);  // (3^2)^2 = 81
    
    println(result1);  // 20
    println(result2);  // 81
}

// ============================================
// 6. 闭包与控制流
// ============================================

fn test_closure_control_flow() {
    let threshold = 50;
    
    let filter = (x: i32) -> bool {
        if x > threshold {
            return true;
        }
        return false;
    };
    
    println(filter(30));  // false
    println(filter(70));  // true
}

// ============================================
// 7. 多变量捕获
// ============================================

fn test_multi_capture() {
    let a = 10;
    let b = 20;
    let c = 30;
    
    // ✅ 捕获多个变量
    let calc = (x: i32) -> i32 {
        x + a + b + c  // 捕获a, b, c
    };
    
    println(calc(5));  // 65
}

// ============================================
// 8. 闭包与类型推导
// ============================================

fn test_type_inference() {
    // 类型推导：从返回类型推导参数类型
    let add: fn(i32, i32) -> i32 = (x, y) { x + y };
    
    // 完整类型注解
    let multiply = (x: i32, y: i32) -> i32 { x * y };
    
    println(add(3, 4));       // 7
    println(multiply(5, 6));  // 30
}

// ============================================
// 9. 实用示例：计算器
// ============================================

type Operation = fn(i32, i32) -> i32;

fn calculator(op: string) -> Operation {
    let add = (x: i32, y: i32) -> i32 { x + y };
    let sub = (x: i32, y: i32) -> i32 { x - y };
    let mul = (x: i32, y: i32) -> i32 { x * y };
    let div = (x: i32, y: i32) -> i32 {
        if y == 0 {
            return 0;
        }
        return x / y;
    };
    
    // 根据操作符返回不同的闭包
    return op is {
        "add" => add,
        "sub" => sub,
        "mul" => mul,
        "div" => div,
        _ => add,
    };
}

fn test_calculator() {
    let add_op = calculator("add");
    let mul_op = calculator("mul");
    
    println(add_op(10, 5));  // 15
    println(mul_op(10, 5));  // 50
}

// ============================================
// 10. 实用示例：迭代器风格
// ============================================

fn filter(arr: [i32; 5], predicate: fn(i32) -> bool) -> [i32; 5] {
    // 简化：返回满足条件的元素（实际应该返回可变长数组）
    let~ result: [i32; 5] = [0, 0, 0, 0, 0];
    let~ count = 0;
    
    loop i in 0..5 {
        if predicate(arr[i]) {
            result[count] = arr[i];
            count = count + 1;
        }
    }
    
    return result;
}

fn test_filter() {
    let numbers: [i32; 5] = [1, 2, 3, 4, 5];
    
    // 使用闭包作为谓词
    let threshold = 2;
    let filtered = filter(numbers, (x: i32) -> bool {
        x > threshold  // 捕获threshold
    });
    
    // 打印结果
    loop i in 0..5 {
        if filtered[i] != 0 {
            println(filtered[i]);
        }
    }
}

// ============================================
// 主函数
// ============================================

fn main() {
    println("=== 闭包功能演示 ===");
    
    test_basic_closure();
    test_implicit_return();
    test_capture();
    test_closure_factory();
    test_higher_order();
    test_closure_control_flow();
    test_multi_capture();
    test_type_inference();
    test_calculator();
    test_filter();
    
    println("=== 演示完成 ===");
}



