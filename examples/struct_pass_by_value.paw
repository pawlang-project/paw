// Struct按值传递测试

type Point = struct {
    x: i32,
    y: i32,
}

type Rectangle = struct {
    width: i32,
    height: i32,
}

// 函数接收Struct按值传递
fn get_area(rect: Rectangle) -> i32 {
    return rect.width * rect.height;
}

// 函数接收Point按值传递
fn distance_from_origin(p: Point) -> i32 {
    return p.x * p.x + p.y * p.y;
}

// 交换Point的x和y
fn swap_coords(p: Point) -> Point {
    return Point { x: p.y, y: p.x };
}

fn main() -> i32 {
    println("╔═══════════════════════════════════════╗");
    println("║  Struct按值传递测试                 ║");
    println("╚═══════════════════════════════════════╝");
    println("");
    
    // 测试1：Rectangle按值传递
    println("测试1：Rectangle按值传递");
    let rect: Rectangle = Rectangle { width: 10, height: 20 };
    let area: i32 = get_area(rect);
    debug(area);  // 应该是200
    assert(area == 200);
    println("  ✓ Rectangle按值传递成功");
    
    // 测试2：Point按值传递
    println("测试2：Point按值传递");
    let p: Point = Point { x: 3, y: 4 };
    let dist: i32 = distance_from_origin(p);
    debug(dist);  // 应该是25 (3*3 + 4*4)
    assert(dist == 25);
    println("  ✓ Point按值传递成功");
    
    // 测试3：返回Struct
    println("测试3：Struct返回值");
    let swapped: Point = swap_coords(p);
    debug(swapped.x);  // 应该是4
    debug(swapped.y);  // 应该是3
    assert(swapped.x == 4);
    assert(swapped.y == 3);
    println("  ✓ Struct返回值成功");
    
    println("");
    println("╔═══════════════════════════════════════╗");
    println("║  ✅ 所有测试通过！                  ║");
    println("╚═══════════════════════════════════════╝");
    
    return 0;
}

