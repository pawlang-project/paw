// 测试约束验证是否真正工作

type Display = interface {
    fn to_string(self) -> string;
}

type Clone = interface {
    fn clone(self) -> Self;
}

// 定义一个实现了 Display 的类型
type GoodType = struct(Display) {
    value: i32,
    
    fn to_string(self) -> string {
        return "GoodType";
    }
}

// 定义一个没有实现 Display 的类型
type BadType = struct {
    value: i32,
}

// 定义带约束的泛型 struct
type Box<T: Display> = struct {
    data: T,
}

fn main() -> i32 {
    println("===== 约束验证测试 =====");
    
    // ✅ 测试1：使用实现了 Display 的类型
    println("1. 使用 GoodType（实现了Display）:");
    let b1 = Box { data: GoodType { value: 42 } };
    println("  Box<GoodType> 创建成功 ✅");
    println("");
    
    // ❌ 测试2：使用没有实现 Display 的类型（应该编译错误）
    // println("2. 使用 BadType（没有实现Display）:");
    // let b2 = Box { data: BadType { value: 100 } };  // 应该报错！
    // println("  Box<BadType> 创建成功");
    
    println("===== 测试完成 =====");
    return 0;
}

