// 测试不同整数类型的切片

// i8切片
fn sum_i8(arr: [i8]) -> i32 {
    let mut total: i32 = 0;
    loop item in arr {
        total = total + (item as i32);
    }
    return total;
}

// i64切片
fn sum_i64(arr: [i64]) -> i64 {
    let mut total: i64 = 0;
    loop item in arr {
        total = total + item;
    }
    return total;
}

// u32切片
fn sum_u32(arr: [u32]) -> u32 {
    let mut total: u32 = 0;
    loop item in arr {
        total = total + item;
    }
    return total;
}

fn main() -> i32 {
    // i8切片
    let arr_i8: [i8] = [1, 2, 3];
    let s1: i32 = sum_i8(arr_i8);  // 6
    
    // i64切片
    let arr_i64: [i64] = [10, 20, 30];
    let s2: i64 = sum_i64(arr_i64);  // 60
    
    // u32切片
    let arr_u32: [u32] = [5, 10, 15];
    let s3: u32 = sum_u32(arr_u32);  // 30
    
    // 返回: 6 + 60 + 30 = 96
    return s1 + (s2 as i32) + (s3 as i32);
}

