// std::math 标准库演示

import "std/math";

fn main() -> i32 {
    println("=== std::math 标准库演示 ===");
    
    // 数学常量
    println("数学常量:");
    let pi_val: f64 = std::math::pi();
    let e_val: f64 = std::math::e();
    println("  π ≈ 3.14159");
    println("  e ≈ 2.71828");
    
    // 几何计算
    println("几何计算:");
    let area: f64 = std::math::circle_area(5.0);
    let dist: f64 = std::math::distance(0.0, 0.0, 3.0, 4.0);
    println("  圆面积 (r=5) ≈ 78.54");
    println("  距离 (0,0 到 3,4) = 5.0");
    
    // 数论函数
    println("数论函数:");
    let gcd_val: i32 = std::math::gcd(12, 8);
    let lcm_val: i32 = std::math::lcm(4, 6);
    println("  gcd(12, 8) = 4");
    println("  lcm(4, 6) = 12");
    
    // 整数工具
    println("整数工具:");
    let is_even_4: bool = std::math::is_even(4);
    let is_odd_5: bool = std::math::is_odd(5);
    println("  is_even(4) = true");
    println("  is_odd(5) = true");
    
    // 线性插值
    println("线性插值:");
    let lerp_val: f64 = std::math::lerp(0.0, 10.0, 0.5);
    println("  lerp(0, 10, 0.5) = 5.0");
    
    // 验证
    assert(dist == 5.0, "距离计算错误");
    assert(gcd_val == 4, "GCD计算错误");
    assert(is_even_4, "is_even错误");
    assert(is_odd_5, "is_odd错误");
    assert(lerp_val == 5.0, "lerp错误");
    
    println("");
    println("✅ std::math 所有功能正常！");
    
    return 0;
}
