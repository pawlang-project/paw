// 测试扩展接口实现 - 基础测试
// 目标：为内置类型实现接口

import "std::interfaces";
import "std::impls::primitives";

fn main() -> i32 {
    println("===== 扩展接口实现测试 =====");
    println("");
    
    // 测试 i32 的 Display
    println("1. i32 Display:");
    let x = 42;
    println(x.to_string());
    println("");
    
    // 测试 f64 的 Display
    println("2. f64 Display:");
    let f = 3.14;
    println(f.to_string());
    println("");
    
    // 测试 bool 的 Display
    println("3. bool Display:");
    let b = true;
    println(b.to_string());
    println("");
    
    // 测试 string 的 Display（直接返回自身）
    println("4. string Display:");
    let s = "hello";
    println(s.to_string());
    println("");
    
    // 测试 char 的 Display
    println("5. char Display:");
    let c = 'A';
    println(c.to_string());
    println("");
    
    // 测试 Clone
    println("6. Clone interface:");
    let y = 100;
    let z = y.clone();
    println(int_to_string(z));
    println("");
    
    // 测试 Eq
    println("7. Eq interface:");
    let a = 10;
    let b2 = 10;
    if a.eq(b2) {
        println("10 == 10: true");
    } else {
        println("10 == 10: false");
    }
    println("");
    
    println("===== 所有测试完成 =====");
    return 0;
}

