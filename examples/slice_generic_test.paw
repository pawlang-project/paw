// 测试泛型切片

type Box<T> = struct {
    value: T,
}

// 泛型函数：提取所有Box中的值并求和
fn sum_boxes(boxes: [Box<i32>]) -> i32 {
    let mut total: i32 = 0;
    loop b in boxes {
        total = total + b.value;
    }
    return total;
}

// 泛型函数：计算Box数组的长度
fn count_boxes(boxes: [Box<i32>]) -> i32 {
    let mut count: i32 = 0;
    loop b in boxes {
        count = count + 1;
    }
    return count;
}

fn main() -> i32 {
    let b1: Box<i32> = Box { value: 10 };
    let b2: Box<i32> = Box { value: 20 };
    let b3: Box<i32> = Box { value: 30 };
    
    let boxes: [Box<i32>] = [b1, b2, b3];
    
    let sum: i32 = sum_boxes(boxes);    // 60
    let count: i32 = count_boxes(boxes); // 3
    
    return sum + count;  // 60 + 3 = 63
}

