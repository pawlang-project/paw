// 最简单的结构体切片测试

type Point = struct {
    x: i32,
    y: i32,
}

fn sum_x(points: [Point]) -> i32 {
    let mut total: i32 = 0;
    loop p in points {
        total = total + p.x;
    }
    return total;
}

fn main() -> i32 {
    let p1: Point = Point { x: 1, y: 2 };
    let p2: Point = Point { x: 3, y: 4 };
    
    let points: [Point] = [p1, p2];
    
    return sum_x(points);  // 应该返回 1 + 3 = 4
}

