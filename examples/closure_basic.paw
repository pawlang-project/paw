// 基础闭包测试

fn main() -> i32 {
    // 测试1: 简单闭包
    let add = (x: i32, y: i32) -> i32 { x + y };
    let result = add(10, 20);
    println(f"add(10, 20) = {result}");
    
    // 测试2: 单参数闭包
    let double = (x: i32) -> i32 { x * 2 };
    println(f"double(5) = {double(5)}");
    
    // 测试3: 无参数闭包
    let get_value = () -> i32 { 42 };
    println(f"get_value() = {get_value()}");
    
    return 0;
}

