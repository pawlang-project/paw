// 测试切片接收不同大小的数组

fn sum(arr: [i32]) -> i32 {
    let mut total: i32 = 0;
    loop item in arr {
        total = total + item;
    }
    return total;
}

fn main() -> i32 {
    let arr3: [i32] = [1, 2, 3];
    let arr5: [i32] = [10, 20, 30, 40, 50];
    
    let s1: i32 = sum(arr3);   // 6
    let s2: i32 = sum(arr5);   // 150
    
    return s1 + s2;  // 156
}

