// 测试不同类型的切片

// f64切片
fn sum_f64(numbers: [f64]) -> f64 {
    let mut total: f64 = 0.0;
    loop item in numbers {
        total = total + item;
    }
    return total;
}

// bool切片
fn count_true(flags: [bool]) -> i32 {
    let mut count: i32 = 0;
    loop flag in flags {
        if flag {
            count = count + 1;
        }
    }
    return count;
}

// char切片
fn concat_chars(chars: [char]) -> i32 {
    let mut sum: i32 = 0;
    loop ch in chars {
        sum = sum + 1;
    }
    return sum;
}

fn main() -> i32 {
    // 测试f64切片
    let floats: [f64] = [1.5, 2.5, 3.0];
    let f_sum: f64 = sum_f64(floats);  // 7.0
    
    // 测试bool切片
    let bools: [bool] = [true, false, true, true];
    let b_count: i32 = count_true(bools);  // 3
    
    // 测试char切片
    let chars: [char] = ['a', 'b', 'c'];
    let c_count: i32 = concat_chars(chars);  // 3
    
    // 返回: 7 + 3 + 3 = 13
    return (f_sum as i32) + b_count + c_count;
}

