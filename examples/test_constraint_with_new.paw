// 测试约束检查 - 使用构造函数

type Display = interface {
    fn to_string(self) -> string;
}

// GoodType 实现了 Display
type GoodType = struct(Display) {
    value: i32,
    
    fn to_string(self) -> string {
        return "GoodType";
    }
}

// BadType 没有实现 Display
type BadType = struct {
    value: i32,
}

// Box<T> 要求 T 必须实现 Display
type Box<T: Display> = struct {
    data: T,
    
    // 构造函数
    pub fn new(value: T) -> Box<T> {
        return Box { data: value };
    }
}

fn main() -> i32 {
    println("===== 约束检查测试（使用构造函数） =====");
    
    // ✅ 测试1：使用实现了 Display 的类型
    println("1. Box::new<GoodType>:");
    let good = GoodType { value: 42 };
    let b1 = Box::new(good);
    println("  成功创建 Box<GoodType> ✅");
    println("");
    
    // ❌ 测试2：使用没有实现 Display 的类型（应该报错）
    println("2. Box::new<BadType>:");
    let bad = BadType { value: 100 };
    let b2 = Box::new(bad);  // 应该在这里报错！
    println("  成功创建 Box<BadType>（不应该成功！）");
    
    return 0;
}

