// 测试枚举切片

type Status = enum {
    Success(i32),
    Error(string),
}

// 计算成功的数量
fn count_success(statuses: [Status]) -> i32 {
    let mut count: i32 = 0;
    loop s in statuses {
        if s is Success(value) {
            count = count + 1;
        }
    }
    return count;
}

// 获取所有成功值的总和
fn sum_success(statuses: [Status]) -> i32 {
    let mut total: i32 = 0;
    loop s in statuses {
        if s is Success(value) {
            total = total + value;
        }
    }
    return total;
}

fn main() -> i32 {
    let s1: Status = Status::Success(10);
    let s2: Status = Status::Error("oops");
    let s3: Status = Status::Success(20);
    
    let statuses: [Status] = [s1, s2, s3];
    
    let count: i32 = count_success(statuses);  // 2
    let sum: i32 = sum_success(statuses);      // 30
    
    return count + sum;  // 2 + 30 = 32
}

