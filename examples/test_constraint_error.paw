// 约束检查错误测试 - 应该编译失败

type Display = interface {
    fn to_string(self) -> string;
}

// BadType 没有实现 Display
type BadType = struct {
    value: i32,
}

// Box<T> 要求 T 必须实现 Display
type Box<T: Display> = struct {
    data: T,
}

fn main() -> i32 {
    println("这不应该编译成功");
    
    // ❌ BadType 没有实现 Display，应该报错
    let bad = BadType { value: 100 };
    let b = Box<BadType> { data: bad };
    
    return 0;
}

