// 测试泛型接口默认方法调用其他方法

type Comparable<T> = interface {
    fn compare(&self, other: T) -> i32;
    
    fn is_equal(&self, other: T) -> bool {
        println("Calling compare...");
        let cmp = self.compare(other);
        println("Compare result:");
        println(cmp);
        cmp == 0
    }
}

type Number = struct {
    value: i32
}

support Number with Comparable<Number> {
    fn compare(&self, other: Number) -> i32 {
        println("In Number.compare");
        if self.value > other.value {
            1
        } else if self.value < other.value {
            -1
        } else {
            0
        }
    }
}

fn main() {
    println("==== 泛型默认方法调用测试 ====\n");
    
    let n1 = Number { value: 10 };
    let n2 = Number { value: 10 };
    
    println("Testing is_equal:");
    let eq = n1.is_equal(n2);
    println("Result:");
    println(eq);
    
    println("\n==== 完成 ====");
}

