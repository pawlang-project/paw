// 简化的约束检查测试

type Display = interface {
    fn to_string(self) -> string;
}

// 使用i32（应该已经实现了Display）
support Display for i32 {
    fn to_string(self) -> string {
        return "[i32]";
    }
}

// Box<T> 要求 T 必须实现 Display
type Box<T: Display> = struct {
    data: T,
}

fn main() -> i32 {
    println("===== 简化约束检查测试 =====");
    
    // ✅ i32 实现了 Display
    let b = Box<i32> { data: 42 };
    println("✅ Box<i32> 创建成功");
    
    return 0;
}

