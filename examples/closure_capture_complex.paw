// 复杂环境捕获测试

fn main() -> i32 {
    println("=== Complex Capture Test ===");
    
    // 测试1: 嵌套捕获
    let x = 5;
    let y = 10;
    let nested = (a: i32) -> i32 {
        let inner = (b: i32) -> i32 { return x + y + a + b; };
        return inner(3);
    };
    println(f"1. nested(2) = {nested(2)}");  // 5+10+2+3 = 20
    
    // 测试2: 多个闭包捕获同一个变量
    let factor = 100;
    let add_factor = (n: i32) -> i32 { return n + factor; };
    let mul_factor = (n: i32) -> i32 { return n * factor; };
    println(f"2. add_factor(5) = {add_factor(5)}");  // 105
    println(f"3. mul_factor(2) = {mul_factor(2)}");  // 200
    
    println("=== All complex tests passed! ===");
    return 0;
}

