// 测试泛型接口实现 - Phase 2

// 定义接口
type Display = interface {
    fn to_string(self) -> string;
}

// 定义泛型 Box<T>
type Box<T> = struct {
    value: T,
}

// ✅ 泛型接口实现：为 Box<T> 实现 Display，只要 T 实现了 Display
support<T: Display> Display for Box<T> {
    fn to_string(self) -> string {
        return "Box";
    }
}

// 定义一个实现了 Display 的类型
type Point = struct(Display) {
    x: i32,
    y: i32,
    
    fn to_string(self) -> string {
        return "Point";
    }
}

fn main() -> i32 {
    println("===== 泛型接口实现测试 =====");
    
    // 创建 Box<Point>
    let p = Point { x: 10, y: 20 };
    let b = Box { value: p };
    
    // Box<Point> 应该自动实现 Display（因为 Point 实现了 Display）
    let s = b.to_string();
    println(s);
    
    println("===== 测试完成 =====");
    return 0;
}

