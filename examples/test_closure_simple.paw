// 最简单的闭包测试

fn main() {
    println("==== 简单闭包测试 ====");
    
    // 测试1: 无捕获
    println("测试1: 无捕获");
    let f1 = () -> i32 { 42 };
    println(f1());
    
    // 测试2: 单变量捕获
    println("测试2: 单变量捕获");
    let x = 10;
    let f2 = () -> i32 { x };
    println(f2());
    
    // 测试3: 简单运算
    println("测试3: 简单运算");
    let y = 20;
    let f3 = () -> i32 { y + 5 };
    println(f3());
    
    println("==== 完成 ====");
}
