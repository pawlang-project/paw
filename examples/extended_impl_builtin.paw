// 测试 Phase 1.5：为内置类型实现接口

// 定义接口
type Display = interface {
    fn to_string(self) -> string;
}

// ✅ 为 i32 实现 Display
support Display for i32 {
    fn to_string(self) -> string {
        return int_to_string(self);
    }
}

// ✅ 为 f64 实现 Display
support Display for f64 {
    fn to_string(self) -> string {
        return float_to_string(self);
    }
}

// ✅ 为 bool 实现 Display
support Display for bool {
    fn to_string(self) -> string {
        if self {
            return "true";
        } else {
            return "false";
        }
    }
}

fn main() -> i32 {
    println("===== 内置类型接口实现测试 =====");
    
    // 测试 i32
    let x = 42;
    let s = x.to_string();
    println("i32.to_string():");
    println(s);
    
    // 测试 f64
    let f = 3.14;
    let s2 = f.to_string();
    println("f64.to_string():");
    println(s2);
    
    // 测试 bool
    let b = true;
    let s3 = b.to_string();
    println("bool.to_string():");
    println(s3);
    
    println("===== 测试完成 =====");
    return 0;
}

