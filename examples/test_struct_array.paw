// 结构体数组测试

type Point = struct {
    x: i32,
    y: i32
};

fn main() {
    let points = [
        Point { x: 0, y: 0 },
        Point { x: 5, y: 10 },
        Point { x: 15, y: 20 }
    ];
    
    println("Testing struct array:");
    loop i in 0..3 {
        let p = points[i];
        println(p.x);
        println(p.y);
    }
    
    println("Struct array test completed!");
}

