// 守卫模式综合测试 v0.2.2

fn main() -> void {
    println("━━━━━━━━━━━━━━━━━━━━━━━━");
    println("守卫模式 (Guard Pattern)");
    println("━━━━━━━━━━━━━━━━━━━━━━━━");
    println("");
    
    test_basic();
    test_multiple();
    test_with_patterns();
    
    println("━━━━━━━━━━━━━━━━━━━━━━━━");
    println("✅ 守卫模式测试通过！");
    println("━━━━━━━━━━━━━━━━━━━━━━━━");
}

fn test_basic() -> void {
    println("1. 基础守卫");
    let x = 10;
    let r = x is {
        10 if true => 100,
        10 => 50,
        _ => 0
    };
    println(r);  // 100
}

fn test_multiple() -> void {
    println("2. 多个守卫");
    let x = 5;
    let r1 = x is {
        5 if false => 10,
        5 if true => 20,
        _ => 30
    };
    println(r1);  // 20 (第一个守卫失败，第二个成功)
    
    let r2 = x is {
        5 if false => 10,
        5 if false => 20,
        _ => 30
    };
    println(r2);  // 30 (所有守卫都失败，匹配通配符)
}

fn test_with_patterns() -> void {
    println("3. 复杂模式 + 守卫");
    
    // 测试: 范围 + 守卫
    let score = 85;
    let grade = score is {
        90..100 => "A",
        80..90 if true => "B+",
        80..90 => "B",
        _ => "C"
    };
    println(grade);  // B+
    
    // 测试: OR + 守卫  
    let x = 2;
    let result = x is {
        1 | 2 | 3 if false => 10,
        1 | 2 | 3 if true => 20,
        _ => 30
    };
    println(result);  // 20
}

