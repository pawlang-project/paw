// 简化的泛型和接口改进测试

// ============================================
// 1. 基础泛型结构体
// ============================================

type Box<T> = struct {
    value: T
}

type Pair<T, U> = struct {
    first: T,
    second: U
}

// ============================================
// 2. 基础接口
// ============================================

type Display = interface {
    fn show();
}

type Debug = interface {
    fn debug();
}

// ============================================
// 3. 简单类型
// ============================================

type Point = struct {
    x: i32,
    y: i32
}

// ============================================
// 4. Support 实现测试
// ============================================

support Point with Display {
    fn show() {
        println("Point显示");
    }
}

support Point with Debug {
    fn debug() {
        println("Point调试");
    }
}

// ============================================
// 5. 主函数测试
// ============================================

fn main() {
    println("========================================");
    println("泛型和接口改进测试");
    println("========================================");
    
    // 测试泛型实例化
    let box1 = Box { value: 42 };
    let box2 = Box { value: "hello" };
    
    let pair = Pair { first: 1, second: "one" };
    
    // 测试接口调用
    let p = Point { x: 10, y: 20 };
    p.show();
    p.debug();
    
    println("========================================");
    println("测试完成！");
    println("========================================");
}


