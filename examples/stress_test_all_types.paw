// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PawLang v0.2.2 - 完整类型系统验证测试
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 测试所有28种类型在各系统中的支持

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1. 整数类型 (10种) ✅
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fn test_integers() -> void {
    // 有符号整数
    let i8_val: i8 = 127;
    let i16_val: i16 = 32767;
    let i32_val: i32 = 2147483647;
    let i64_val: i64 = 9223372036854775807;
    let i128_val: i128 = 170141183460469231731687303715884105727;
    
    // 无符号整数
    let u8_val: u8 = 255;
    let u16_val: u16 = 65535;
    let u32_val: u32 = 4294967295;
    let u64_val: u64 = 18446744073709551615;
    let u128_val: u128 = 340282366920938463463374607431768211455;
    
    // 模式匹配测试
    i32_val is {
        2147483647 => { println("i32 match OK"); },
        _ => { println("i32 match FAIL"); }
    };
    
    u64_val is {
        18446744073709551615 => { println("u64 match OK"); },
        _ => { println("u64 match FAIL"); }
    };
    
    println("✅ Integer types: ALL PASS");
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2. 浮点类型 (5种) 🟡
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fn test_floats() -> void {
    // 注意：f8/f16 可能需要显式转换
    let f32_val: f32 = 3.14159;
    let f64_val: f64 = 2.718281828459045;
    let f128_val: f128 = 1.41421356237309504880168872420969807;
    
    // 浮点数模式匹配测试（🟡 验证是否支持）
    // f32_val is {
    //     3.14159 => { println("f32 match OK"); },
    //     _ => { println("f32 match FAIL"); }
    // };
    
    println("🟡 Float types: Parser ✅, CodeGen ✅, Pattern 🟡");
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3. 基础类型 (4种) ✅
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fn test_basic_types() -> void {
    let bool_val: bool = true;
    let char_val: char = 'A';
    let string_val: string = "Hello, PawLang!";
    
    // 模式匹配测试
    bool_val is {
        true => { println("bool match OK"); },
        false => { println("bool match FAIL"); }
    };
    
    string_val is {
        "Hello, PawLang!" => { println("string match OK"); },
        _ => { println("string match FAIL"); }
    };
    
    println("✅ Basic types: ALL PASS");
}

