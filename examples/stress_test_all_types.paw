// 18. SelfType ✅
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

type Counter = struct {
    count: i32
};

type Incrementable = interface {
    fn increment(&self) -> Self;
};

fn test_self_type() -> void {
    println("✅ SelfType: Parser ✅, TypeChecker ✅, CodeGen ✅");
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 19. 类型推导 (Infer) ✅
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fn test_infer() -> void {
    let x = 42;              // 推导为 i32
    let y = 3.14;            // 推导为 f64
    let z = "infer";         // 推导为 string
    
    println(x);
    println(y);
    println(z);
    
    println("✅ Infer: Parser ✅, TypeChecker ✅");
}

