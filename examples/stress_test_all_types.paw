fn test_array() -> void {
    let arr: [i32; 3] = [1, 2, 3];
    
    // 基础访问
    println(arr[0]);  // 1
    println(arr[1]);  // 2
    
    // 🟡 Array 模式匹配测试（验证是否支持解构）
