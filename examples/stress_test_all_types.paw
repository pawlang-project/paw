// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6. 复合类型 - Tuple ✅
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

fn test_tuple() -> void {
    let tuple: (i32, f64, string) = (42, 3.14, "tuple");
    
    // 模式匹配解构
    tuple is {
        (a, b, c) => {
            println("Tuple destructure OK");
        },
        _ => { println("Tuple destructure FAIL"); }
    };
    
    println("✅ Tuple: ALL PASS");
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7. 复合类型 - Struct ✅
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

type Point = struct {
    x: i32,
    y: i32
};

fn test_struct() -> void {
    let p = Point { x: 10, y: 20 };
    
    // 模式匹配解构
    p is {
        Point { x, y } => {
            println("Struct destructure OK");
        },
        _ => { println("Struct destructure FAIL"); }
    };
    
    println("✅ Struct: ALL PASS");
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8. 复合类型 - Enum ✅
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

type Color = enum {
    red,
    green,
    blue,
    rgb(i32, i32, i32)
};

fn test_enum() -> void {
    let color = Color::rgb(255, 128, 0);
    
    // 模式匹配解构
    color is {
        Color::rgb(r, g, b) => {
            println("Enum destructure OK");
        },
        _ => { println("Enum destructure FAIL"); }
    };
    
    println("✅ Enum: ALL PASS");
}

