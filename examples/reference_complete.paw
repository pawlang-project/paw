// 完整引用系统测试

// 测试1：swap函数
fn swap(a: &mut i32, b: &mut i32) {
    let temp: i32 = *a;
    *a = *b;
    *b = temp;
}

// 测试2：数组求和（切片引用）
fn sum(arr: &[i32]) -> i32 {
    let mut total: i32 = 0;
    loop item in arr {
        total = total + item;
    }
    return total;
}

// 测试3：修改值
fn increment(x: &mut i32) {
    *x = *x + 1;
}

fn main() -> i32 {
    println("=== 完整引用测试 ===");
    
    // 测试swap
    println("\n1. Swap测试:");
    let mut x: i32 = 10;
    let mut y: i32 = 20;
    print("Before: x=");
    debug(x);
    print("Before: y=");
    debug(y);
    
    swap(&mut x, &mut y);
    
    print("After: x=");
    debug(x);  // 20
    print("After: y=");
    debug(y);  // 10
    
    // 测试切片引用
    println("\n2. 切片引用测试:");
    let nums: [i32; 5] = [1, 2, 3, 4, 5];
    let total: i32 = sum(&nums);
    print("Sum of [1,2,3,4,5] = ");
    debug(total);  // 15
    
    // 测试部分切片
    let partial: i32 = sum(&nums[1..4]);
    print("Sum of [2,3,4] = ");
    debug(partial);  // 9
    
    // 测试increment
    println("\n3. Increment测试:");
    let mut n: i32 = 100;
    print("Before: n=");
    debug(n);
    
    increment(&mut n);
    
    print("After: n=");
    debug(n);  // 101
    
    // 测试unsafe块
    println("\n4. Unsafe块测试:");
    let mut val: i32 = 50;
    
    unsafe {
        let r1: &mut i32 = &mut val;
        let r2: &mut i32 = &mut val;
        *r1 = 75;
        *r2 = 99;
    }
    
    print("val = ");
    debug(val);  // 99
    
    println("\n✅ 所有引用测试通过！");
    return 0;
}

