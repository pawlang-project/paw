// 完整的约束检查测试 - 成功案例

type Display = interface {
    fn to_string(self) -> string;
}

//  === 1. 内置类型实现 ===
support Display for i32 {
    fn to_string(self) -> string {
        return "[i32]";
    }
}

// === 2. 自定义类型实现 ===
type Point = struct {
    x: i32,
    y: i32,
}

support Display for Point {
    fn to_string(self) -> string {
        return "Point";
    }
}

// === 3. 泛型类型（带约束）===
type Box<T: Display> = struct {
    data: T,
}

fn main() -> i32 {
    println("===== 完整约束检查测试 =====");
    println("");
    
    // ✅ 测试1: Box<i32>
    println("1. Box<i32> (内置类型实现):");
    let b1 = Box<i32> { data: 42 };
    println("  ✅ 成功");
    println("");
    
    // ✅ 测试2: Box<Point>
    println("2. Box<Point> (自定义类型实现):");
    let p = Point { x: 10, y: 20 };
    let b2 = Box<Point> { data: p };
    println("  ✅ 成功");
    println("");
    
    println("===== 所有测试通过 =====");
    return 0;
}

