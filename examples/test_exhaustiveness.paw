// 测试模式穷尽性检查

type Status = enum {
    Active,
    Inactive,
    Pending
}

fn test_exhaustive(s: Status) -> string {
    // 应该通过：覆盖所有variant
    return s is {
        Active => "active",
        Inactive => "inactive",
        Pending => "pending"
    };
}

fn test_with_wildcard(s: Status) -> string {
    // 应该通过：有通配符
    return s is {
        Active => "active",
        _ => "other"
    };
}

fn test_non_exhaustive(s: Status) -> string {
    // 应该报错：缺少Pending
    return s is {
        Active => "active",
        Inactive => "inactive"
    };
}

fn main() {
    println("==== 穷尽性检查测试 ====");
    
    let status = Status::Active;
    println(test_exhaustive(status));
    println(test_with_wildcard(status));
    
    println("==== 测试完成 ====");
}


