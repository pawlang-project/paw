// 测试内联接口实现是否正常工作

type Display = interface {
    fn to_string(self) -> string;
}

// ✅ 内联实现：type T = struct(I) { ... }
type Point = struct(Display) {
    x: i32,
    y: i32,
    
    fn to_string(self) -> string {
        return "Point(inline)";
    }
}

fn main() -> i32 {
    println("===== 测试内联接口实现 =====");
    
    let p = Point { x: 10, y: 20 };
    let s = p.to_string();
    println(s);
    
    println("===== 测试完成 =====");
    return 0;
}

