// 全浮点类型精度测试
// 测试所有5种浮点类型的精度

fn main() -> void {
    println("=== 浮点类型精度测试 ===");
    
    // f8: 8位浮点（非标准，待验证）
    let f8_val: f8 = 3.14;
    println(f8_val);
    
    // f16: 半精度浮点
    let f16_val: f16 = 3.14159;
    println(f16_val);
    
    // f32: 单精度浮点
    let f32_val: f32 = 3.14159265;
    println(f32_val);
    
    // f64: 双精度浮点
    let f64_val: f64 = 3.14159265358979323846;
    println(f64_val);
    
    // f128: 四精度浮点
    let f128_val: f128 = 3.14159265358979323846264338327950288;
    println(f128_val);
    
    println("=== 浮点精度对比 ===");
    
    // 精度测试：π的不同精度
    let pi_f16: f16 = 3.141592653589793;
    let pi_f32: f32 = 3.141592653589793;
    let pi_f64: f64 = 3.141592653589793;
    let pi_f128: f128 = 3.141592653589793238462643383279502884197;
    
    println(pi_f16);
    println(pi_f32);
    println(pi_f64);
    println(pi_f128);
    
    println("=== 浮点类型测试完成 ===");
}

