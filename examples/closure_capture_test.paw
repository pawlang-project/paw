// 测试环境捕获

fn main() -> i32 {
    println("=== Closure Capture Test ===");
    
    // 测试1: 捕获单个变量
    let x = 10;
    let add_x = (y: i32) -> i32 { return x + y; };
    println(f"1. add_x(5) = {add_x(5)}");
    
    // 测试2: 捕获多个变量
    let a = 10;
    let b = 20;
    let combine = (z: i32) -> i32 { return a + b + z; };
    println(f"2. combine(5) = {combine(5)}");
    
    // 测试3: 捕获后修改（按值捕获）
    let factor = 2;
    let multiply = (n: i32) -> i32 { return n * factor; };
    println(f"3. multiply(10) = {multiply(10)}");
    
    println("=== All capture tests passed! ===");
    return 0;
}

