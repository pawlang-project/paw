// 元组解构测试

fn create_pair() -> (i32, i32) {
    return (10, 20);
}

fn main() -> i32 {
    println("=== 元组解构测试 ===");
    
    // 测试1：简单的二元组解构
    let pair: (i32, string) = (42, "hello");
    let (x, y): (i32, string) = pair;
    
    print("x = ");
    debug(x);  // 应该输出 42
    print("y = ");
    debug(y);  // 应该输出 hello
    
    // 测试2：三元组解构
    let triple: (i32, f64, bool) = (100, 3.14, true);
    let (a, b, c): (i32, f64, bool) = triple;
    
    print("a = ");
    debug(a);  // 应该输出 100
    print("b = ");
    debug(b);  // 应该输出 3.14
    print("c = ");
    debug(c);  // 应该输出 true
    
    // 测试3：直接从函数返回值解构
    let (m, n): (i32, i32) = create_pair();
    print("m = ");
    debug(m);  // 应该输出 10
    print("n = ");
    debug(n);  // 应该输出 20
    
    // 测试4：嵌套元组解构
    let nested: ((i32, i32), string) = ((1, 2), "data");
    let (inner, text): ((i32, i32), string) = nested;
    
    // inner 是一个元组，text 是字符串
    print("text = ");
    debug(text);  // 应该输出 data
    
    // 进一步解构 inner
    let (p, q): (i32, i32) = inner;
    print("p = ");
    debug(p);  // 应该输出 1
    print("q = ");
    debug(q);  // 应该输出 2
    
    println("✅ 所有元组解构测试通过！");
    return 0;
}

