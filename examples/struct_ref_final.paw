// Struct引用完整测试

type Point = struct {
    x: i32,
    y: i32,
}

// 只读引用
fn get_x(p: &Point) -> i32 {
    return p.x;
}

// 可变引用
fn set_x(p: &mut Point, new_x: i32) {
    p.x = new_x;
}

fn main() -> i32 {
    println("=== Struct引用测试 ===");
    
    // 测试1：只读引用
    let p1: Point = Point { x: 42, y: 100 };
    let x_val: i32 = get_x(&p1);
    print("get_x(&p1) = ");
    debug(x_val);  // 应该是 42
    assert(x_val == 42);
    
    // 测试2：可变引用
    let mut p2: Point = Point { x: 10, y: 20 };
    print("Before: p2.x = ");
    debug(p2.x);  // 10
    
    set_x(&mut p2, 999);
    print("After: p2.x = ");
    debug(p2.x);  // 999
    assert(p2.x == 999);
    
    println("✅ 所有Struct引用测试通过！");
    return 0;
}

