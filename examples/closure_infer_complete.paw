// 闭包参数类型推导 - 完整测试
// Phase 3: 完全可用！

fn main() -> i32 {
    println("=== Closure Parameter Type Inference Test ===");
    
    // Test 1: 单参数类型推导 ✅
    let double: fn(i32) -> i32 = (x) -> { return x * 2; };
    println(f"1. double(21) = {double(21)}");
    
    // Test 2: 双参数类型推导 ✅
    let add: fn(i32, i32) -> i32 = (x, y) -> { return x + y; };
    println(f"2. add(10, 20) = {add(10, 20)}");
    
    // Test 3: 无参数闭包（不需要推导）✅
    let get_value: fn() -> i32 = () -> { return 42; };
    println(f"3. get_value() = {get_value()}");
    
    // Test 4: 链式调用 ✅
    let triple: fn(i32) -> i32 = (n) -> { return n * 3; };
    println(f"4. triple(double(5)) = {triple(double(5))}");
    
    println("=== All type inference tests passed! ===");
    return 0;
}

