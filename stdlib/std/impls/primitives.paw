// 为内置类型实现标准接口
//
// 这个模块为 i32, i64, f64, string, bool, char 等内置类型
// 实现了常用的接口，使它们可以被统一处理

import "std::interfaces";

// ========== Display 接口 ==========

// 为 i32 实现 Display
support Display for i32 {
    fn to_string(self) -> string {
        return int_to_string(self);
    }
}

// 为 i64 实现 Display  
support Display for i64 {
    fn to_string(self) -> string {
        return int_to_string(self);
    }
}

// 为 f64 实现 Display
support Display for f64 {
    fn to_string(self) -> string {
        return float_to_string(self);
    }
}

// 为 string 实现 Display（直接返回自身）
support Display for string {
    fn to_string(self) -> string {
        return self;
    }
}

// 为 bool 实现 Display
support Display for bool {
    fn to_string(self) -> string {
        if self {
            return "true";
        } else {
            return "false";
        }
    }
}

// 为 char 实现 Display
support Display for char {
    fn to_string(self) -> string {
        return char_to_string(self);
    }
}

// ========== Clone 接口 ==========

// 内置类型都是值类型，Clone 很简单

support Clone for i32 {
    fn clone(self) -> i32 {
        return self;
    }
}

support Clone for i64 {
    fn clone(self) -> i64 {
        return self;
    }
}

support Clone for f64 {
    fn clone(self) -> f64 {
        return self;
    }
}

support Clone for bool {
    fn clone(self) -> bool {
        return self;
    }
}

support Clone for char {
    fn clone(self) -> char {
        return self;
    }
}

// ========== Eq 接口 ==========

support Eq for i32 {
    fn eq(self, other: i32) -> bool {
        return self == other;
    }
    
    fn ne(self, other: i32) -> bool {
        return self != other;
    }
}

support Eq for i64 {
    fn eq(self, other: i64) -> bool {
        return self == other;
    }
    
    fn ne(self, other: i64) -> bool {
        return self != other;
    }
}

support Eq for f64 {
    fn eq(self, other: f64) -> bool {
        return self == other;
    }
    
    fn ne(self, other: f64) -> bool {
        return self != other;
    }
}

support Eq for bool {
    fn eq(self, other: bool) -> bool {
        return self == other;
    }
    
    fn ne(self, other: bool) -> bool {
        return self != other;
    }
}

support Eq for char {
    fn eq(self, other: char) -> bool {
        return self == other;
    }
    
    fn ne(self, other: char) -> bool {
        return self != other;
    }
}

