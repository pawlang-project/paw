// std::collections::collections - 数组和切片的统一泛型集合库
// 提供完全泛型的集合操作

// 注意：以下是内置函数，可以直接使用：
//   len(arr/slice) - 获取长度
//   is_empty(arr/slice) - 检查是否为空
//   abs(x), min(a, b), max(a, b), clamp(val, min, max) - 数学工具

// ========================================
// 通用集合操作（完全泛型）
// ========================================

// 计算和
pub fn sum<T>(items: [T]) -> T {
    let mut total: T = 0 as T;
    loop item in items {
        total = total + item;
    }
    return total;
}

// 查找最大值
pub fn max_value<T>(items: [T]) -> T {
    if is_empty(items) {
        return 0 as T;
    }
    
    let mut max_val: T = items[0];
    let mut i: i64 = 1;
    
    loop i < len(items) {
        max_val = max(max_val, items[i as i32]);
        i = i + 1;
    }
    
    return max_val;
}

// 查找最小值
pub fn min_value<T>(items: [T]) -> T {
    if is_empty(items) {
        return 0 as T;
    }
    
    let mut min_val: T = items[0];
    let mut i: i64 = 1;
    
    loop i < len(items) {
        min_val = min(min_val, items[i as i32]);
        i = i + 1;
    }
    
    return min_val;
}

// 获取第一个元素
pub fn first<T>(items: [T]) -> T {
    if is_empty(items) {
        return 0 as T;
    }
    return items[0];
}

// 获取最后一个元素
pub fn last<T>(items: [T]) -> T {
    let size: i64 = len(items);
    if size == 0 {
        return 0 as T;
    }
    return items[(size - 1) as i32];
}

// 检查是否包含指定值
pub fn contains<T>(items: [T], value: T) -> bool {
    loop item in items {
        if item == value {
            return true;
        }
    }
    return false;
}

// 查找元素的索引（-1表示未找到）
pub fn index_of<T>(items: [T], value: T) -> i64 {
    let mut i: i64 = 0;
    loop item in items {
        if item == value {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// 统计指定值出现的次数
pub fn count<T>(items: [T], value: T) -> i64 {
    let mut result: i64 = 0;
    loop item in items {
        if item == value {
            result = result + 1;
        }
    }
    return result;
}

// 计算平均值
pub fn average<T>(items: [T]) -> T {
    if is_empty(items) {
        return 0 as T;
    }
    
    let total: T = sum<T>(items);
    let size: T = len(items) as T;
    return total / size;
}

// 计算乘积
pub fn product<T>(items: [T]) -> T {
    let mut result: T = 1 as T;
    loop item in items {
        result = result * item;
    }
    return result;
}

// 计算绝对值之和
pub fn abs_sum<T>(items: [T]) -> T {
    let mut total: T = 0 as T;
    loop item in items {
        total = total + abs(item);
    }
    return total;
}

// 检查所有元素是否都为正数
pub fn all_positive<T>(items: [T]) -> bool {
    let zero: T = 0 as T;
    loop item in items {
        if item <= zero {
            return false;
        }
    }
    return true;
}

// 检查是否有任何负数
pub fn any_negative<T>(items: [T]) -> bool {
    let zero: T = 0 as T;
    loop item in items {
        if item < zero {
            return true;
        }
    }
    return false;
}

// 获取最大值和最小值的范围
pub fn range<T>(items: [T]) -> T {
    if is_empty(items) {
        return 0 as T;
    }
    
    let max_val: T = max_value<T>(items);
    let min_val: T = min_value<T>(items);
    
    return max_val - min_val;
}

// 计算元素总数（等同于len，提供语义化接口）
pub fn size<T>(items: [T]) -> i64 {
    return len(items);
}

// 检查是否为空（等同于is_empty，提供语义化接口）
pub fn empty<T>(items: [T]) -> bool {
    return is_empty(items);
}

// 获取范围内的最大值和最小值
pub fn minmax<T>(items: [T]) -> T {
    return range<T>(items);
}
