// std::collections::types - 泛型集合类型
// 提供通用的数据结构

// 注意：对于简单的键值对，推荐使用内置元组类型:
//   let pair: (i32, string) = (42, "hello");
//   let triple: (i32, f64, bool) = (100, 3.14, true);

// ========== Range<T> - 泛型范围 ==========

pub type Range<T> = struct {
    start: T,
    end: T,
    
    pub fn new(s: T, e: T) -> Range<T> {
        return Range<T> { start: s, end: e };
    }
    
    pub fn contains(self, value: T) -> bool {
        return value >= self.start && value < self.end;
    }
}

// ========== Box<T> - 泛型值包装器 ==========

pub type Box<T> = struct {
    value: T,
    
    pub fn new(v: T) -> Box<T> {
        return Box<T> { value: v };
    }
    
    pub fn get(self) -> T {
        return self.value;
    }
}
