// std::math - 数学函数库
// 提供高级数学运算和常用数学工具

// 注意：以下函数现在是内置的，可以直接使用：
//   abs(x), min(a, b), max(a, b), clamp(val, min, max)
//   pow(base, exp), sqrt(x), floor(x), ceil(x), round(x)

// ========== 数学常量 ==========

pub fn pi() -> f64 {
    return 3.141592653589793;
}

pub fn e() -> f64 {
    return 2.718281828459045;
}

// ========== 高级数学函数 ==========

// 计算两点间的欧几里得距离
pub fn distance(x1: f64, y1: f64, x2: f64, y2: f64) -> f64 {
    let dx: f64 = x2 - x1;
    let dy: f64 = y2 - y1;
    return sqrt(pow(dx, 2.0) + pow(dy, 2.0));
}

// 计算圆的面积
pub fn circle_area(radius: f64) -> f64 {
    return pi() * pow(radius, 2.0);
}

// 计算圆的周长
pub fn circle_circumference(radius: f64) -> f64 {
    return 2.0 * pi() * radius;
}

// 角度转弧度
pub fn deg_to_rad(degrees: f64) -> f64 {
    return degrees * pi() / 180.0;
}

// 弧度转角度
pub fn rad_to_deg(radians: f64) -> f64 {
    return radians * 180.0 / pi();
}

// 判断是否接近（用于浮点比较）
pub fn approx_eq(a: f64, b: f64, epsilon: f64) -> bool {
    let diff: f64 = abs(a - b);
    return diff < epsilon;
}

// 线性插值
pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
    let clamped_t: f64 = clamp(t, 0.0, 1.0);
    return a + (b - a) * clamped_t;
}

// ========== 整数数学工具 ==========

// 判断是否为偶数
pub fn is_even(n: i32) -> bool {
    return n % 2 == 0;
}

// 判断是否为奇数
pub fn is_odd(n: i32) -> bool {
    return n % 2 != 0;
}

// 整数幂运算（仅支持非负指数）
pub fn powi(base: i32, exp: i32) -> i32 {
    assert(exp >= 0, "指数必须非负");
    
    if exp == 0 {
        return 1;
    }
    
    let mut result: i32 = 1;
    let mut i: i32 = 0;
    loop i < exp {
        result = result * base;
        i = i + 1;
    }
    return result;
}

// 最大公约数（GCD）
pub fn gcd(a: i32, b: i32) -> i32 {
    let mut x: i32 = abs(a);
    let mut y: i32 = abs(b);
    
    loop y != 0 {
        let temp: i32 = y;
        y = x % y;
        x = temp;
    }
    
    return x;
}

// 最小公倍数（LCM）
pub fn lcm(a: i32, b: i32) -> i32 {
    if a == 0 || b == 0 {
        return 0;
    }
    return abs(a * b) / gcd(a, b);
}

// 阶乘（仅支持小整数，避免溢出）
pub fn factorial(n: i32) -> i32? {
    if n < 0 {
        return err("阶乘不支持负数");
    }
    
    if n > 12 {
        return err("阶乘过大会溢出");
    }
    
    let mut result: i32 = 1;
    let mut i: i32 = 2;
    loop i <= n {
        result = result * i;
        i = i + 1;
    }
    
    return ok(result);
}

// ========== 范围检查工具 ==========

// 检查值是否在范围内
pub fn in_range(val: i32, min_val: i32, max_val: i32) -> bool {
    return val >= min_val && val <= max_val;
}

// 检查值是否在范围内（浮点）
pub fn in_range_f64(val: f64, min_val: f64, max_val: f64) -> bool {
    return val >= min_val && val <= max_val;
}
